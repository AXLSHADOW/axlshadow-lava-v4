# ==============================================================================
# Lavalink Environment Configuration Template
# ==============================================================================
# Copy this file to .env for local testing or configure these variables in the
# Railway Dashboard under "Variables".

# Server Port (Railway automatically sets the PORT variable at runtime)
PORT=2333

# Secure authentication password
# IMPORTANT: Change this to a strong random secret before deploying!
LAVALINK_SERVER_PASSWORD=shqau2n8sl@

# Container memory and JVM tuning options (optional)
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0
